datasource db {
  provider = "postgresql"
}

model app_settings {
  key        String   @id @db.VarChar(100)
  value      Json
  updated_by String?  @db.Uuid
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "app_settings_updated_by_users_id_fk")
}

model audit_logs {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?      @db.Uuid
  action      audit_action
  entity_type String       @db.VarChar(80)
  entity_id   String?      @db.Uuid
  old_values  Json?
  new_values  Json?
  ip_address  String?      @db.VarChar(64)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  users       users?       @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_logs_user_id_users_id_fk")

  @@index([created_at])
  @@index([entity_type, entity_id], map: "audit_logs_entity_idx")
}

model bank_accounts {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String          @unique(map: "bank_accounts_name_unique") @db.VarChar(160)
  bank_name       String?         @db.VarChar(160)
  account_number  String?         @db.VarChar(120)
  iban            String?         @db.VarChar(64)
  opening_balance Decimal         @default(0) @db.Decimal(18, 2)
  is_cash_account Boolean         @default(false)
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  journal_lines   journal_lines[]
  transactions    transactions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bill_items {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bill_id     String    @db.Uuid
  product_id  String?   @db.Uuid
  description String    @db.VarChar(300)
  quantity    Decimal   @db.Decimal(18, 3)
  unit_price  Decimal   @db.Decimal(18, 2)
  line_total  Decimal   @db.Decimal(18, 2)
  sort_order  Int       @default(0)
  bills       bills     @relation(fields: [bill_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bill_items_bill_id_bills_id_fk")
  products    products? @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_items_product_id_products_id_fk")

  @@index([bill_id], map: "bill_items_bill_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bill_of_material_items {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bom_id                 String             @db.Uuid
  material_product_id    String             @db.Uuid
  quantity               Decimal            @db.Decimal(18, 3)
  expected_waste_percent Decimal            @default(0) @db.Decimal(7, 4)
  bills_of_materials     bills_of_materials @relation(fields: [bom_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bill_of_material_items_bom_id_bills_of_materials_id_fk")
  products               products           @relation(fields: [material_product_id], references: [id], onUpdate: NoAction, map: "bill_of_material_items_material_product_id_products_id_fk")

  @@unique([bom_id, material_product_id], map: "bom_items_material_unique")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bills {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bill_number     String       @unique(map: "bills_number_unique") @db.VarChar(64)
  type            bill_type
  status          bill_status  @default(draft)
  party_id        String       @db.Uuid
  bill_date       DateTime     @db.Date
  due_date        DateTime?    @db.Date
  subtotal        Decimal      @db.Decimal(18, 2)
  tax_rate        Decimal      @default(0) @db.Decimal(7, 4)
  tax_amount      Decimal      @default(0) @db.Decimal(18, 2)
  shipping_amount Decimal      @default(0) @db.Decimal(18, 2)
  discount_amount Decimal      @default(0) @db.Decimal(18, 2)
  total_amount    Decimal      @db.Decimal(18, 2)
  notes           String?
  terms           String?
  created_by      String       @db.Uuid
  version         Int          @default(1)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)
  bill_items      bill_items[]
  users           users        @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "bills_created_by_users_id_fk")
  parties         parties      @relation(fields: [party_id], references: [id], onUpdate: NoAction, map: "bills_party_id_parties_id_fk")

  @@index([bill_date], map: "bills_date_idx")
  @@index([party_id], map: "bills_party_idx")
}

model bills_of_materials {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   String                   @unique(map: "boms_code_unique") @db.VarChar(64)
  finished_product_id    String                   @db.Uuid
  output_quantity        Decimal                  @default(1) @db.Decimal(18, 3)
  version_number         Int                      @default(1)
  is_active              Boolean                  @default(true)
  notes                  String?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  bill_of_material_items bill_of_material_items[]
  products               products                 @relation(fields: [finished_product_id], references: [id], onUpdate: NoAction, map: "bills_of_materials_finished_product_id_products_id_fk")
  work_orders            work_orders[]
}

model document_sequences {
  key         String   @id @db.VarChar(80)
  last_number Int      @default(0)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_movements {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id     String                  @db.Uuid
  warehouse_id   String                  @db.Uuid
  transaction_id String?                 @db.Uuid
  movement_type  inventory_movement_type
  quantity_delta Decimal                 @db.Decimal(18, 3)
  unit_cost      Decimal?                @db.Decimal(18, 4)
  occurred_at    DateTime                @default(now()) @db.Timestamptz(6)
  reference      String?                 @db.VarChar(120)
  notes          String?
  created_by     String                  @db.Uuid
  created_at     DateTime                @default(now()) @db.Timestamptz(6)
  users          users                   @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "inventory_movements_created_by_users_id_fk")
  products       products                @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "inventory_movements_product_id_products_id_fk")
  transactions   transactions?           @relation(fields: [transaction_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "inventory_movements_transaction_id_transactions_id_fk")
  warehouses     warehouses              @relation(fields: [warehouse_id], references: [id], onUpdate: NoAction, map: "inventory_movements_warehouse_id_warehouses_id_fk")

  @@index([occurred_at])
  @@index([product_id, warehouse_id], map: "inventory_movements_product_warehouse_idx")
}

model journal_entries {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entry_number   String          @unique(map: "journal_entries_number_unique") @db.VarChar(64)
  entry_date     DateTime        @db.Date
  description    String
  source_type    String          @db.VarChar(50)
  source_id      String?         @db.Uuid
  status         journal_status  @default(posted)
  reversal_of_id String?         @db.Uuid
  created_by     String          @db.Uuid
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  users          users           @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "journal_entries_created_by_users_id_fk")
  journal_lines  journal_lines[]

  @@index([source_type, source_id], map: "journal_entries_source_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model journal_lines {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journal_entry_id String          @db.Uuid
  account_id       String          @db.Uuid
  party_id         String?         @db.Uuid
  bank_account_id  String?         @db.Uuid
  side             journal_side
  amount           Decimal         @db.Decimal(18, 2)
  memo             String?
  ledger_accounts  ledger_accounts @relation(fields: [account_id], references: [id], onUpdate: NoAction, map: "journal_lines_account_id_ledger_accounts_id_fk")
  bank_accounts    bank_accounts?  @relation(fields: [bank_account_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "journal_lines_bank_account_id_bank_accounts_id_fk")
  journal_entries  journal_entries @relation(fields: [journal_entry_id], references: [id], onUpdate: NoAction, map: "journal_lines_journal_entry_id_journal_entries_id_fk")
  parties          parties?        @relation(fields: [party_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "journal_lines_party_id_parties_id_fk")

  @@index([journal_entry_id], map: "journal_lines_entry_idx")
  @@index([party_id], map: "journal_lines_party_idx")
}

model ledger_accounts {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String          @unique(map: "ledger_accounts_code_unique") @db.VarChar(30)
  name          String          @db.VarChar(160)
  type          account_type
  is_system     Boolean         @default(false)
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  journal_lines journal_lines[]
}

model login_attempts {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @db.VarChar(80)
  succeeded    Boolean
  ip_address   String?  @db.VarChar(64)
  user_agent   String?
  attempted_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([username, attempted_at], map: "login_attempts_username_time_idx")
}

model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  title      String    @db.VarChar(180)
  message    String
  type       String    @default("info") @db.VarChar(40)
  href       String?
  read_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_user_id_users_id_fk")

  @@index([user_id, read_at], map: "notifications_user_read_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model parties {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String          @db.VarChar(200)
  contact_person     String?         @db.VarChar(160)
  phone              String?         @db.VarChar(40)
  email              String?         @db.VarChar(255)
  address            String?
  tax_number         String?         @db.VarChar(80)
  is_customer        Boolean         @default(false)
  is_supplier        Boolean         @default(false)
  opening_receivable Decimal         @default(0) @db.Decimal(18, 2)
  opening_payable    Decimal         @default(0) @db.Decimal(18, 2)
  is_active          Boolean         @default(true)
  version            Int             @default(1)
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @db.Timestamptz(6)
  bills              bills[]
  journal_lines      journal_lines[]
  transactions       transactions[]

  @@index([name])
  @@index([is_customer, is_supplier], map: "parties_roles_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                    String                   @unique(map: "products_sku_unique") @db.VarChar(80)
  name                   String                   @db.VarChar(200)
  category               String?                  @db.VarChar(120)
  brand                  String                   @default("Crown") @db.VarChar(120)
  unit                   String                   @default("Pieces") @db.VarChar(40)
  description            String?
  sale_price             Decimal                  @default(0) @db.Decimal(18, 2)
  purchase_price         Decimal                  @default(0) @db.Decimal(18, 2)
  reorder_level          Decimal                  @default(0) @db.Decimal(18, 3)
  is_raw_material        Boolean                  @default(false)
  is_finished_good       Boolean                  @default(true)
  is_active              Boolean                  @default(true)
  version                Int                      @default(1)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  is_sellable            Boolean                  @default(true)
  is_purchasable         Boolean                  @default(true)
  bill_items             bill_items[]
  bill_of_material_items bill_of_material_items[]
  bills_of_materials     bills_of_materials[]
  inventory_movements    inventory_movements[]
  transactions           transactions[]

  @@index([name])
}

model quality_checks {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  work_order_id  String      @db.Uuid
  check_name     String      @db.VarChar(160)
  result         String      @db.VarChar(80)
  measured_value String?     @db.VarChar(120)
  notes          String?
  checked_by     String      @db.Uuid
  checked_at     DateTime    @default(now()) @db.Timestamptz(6)
  users          users       @relation(fields: [checked_by], references: [id], onUpdate: NoAction, map: "quality_checks_checked_by_users_id_fk")
  work_orders    work_orders @relation(fields: [work_order_id], references: [id], onUpdate: NoAction, map: "quality_checks_work_order_id_work_orders_id_fk")

  @@index([work_order_id], map: "quality_checks_work_order_idx")
}

model sessions {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  token_hash   String   @unique(map: "sessions_token_hash_unique") @db.VarChar(64)
  expires_at   DateTime @db.Timestamptz(6)
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)
  user_agent   String?
  ip_address   String?  @db.VarChar(64)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sessions_user_id_users_id_fk")

  @@index([expires_at])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_number      String                @unique(map: "transactions_number_unique") @db.VarChar(64)
  type                    transaction_type
  status                  transaction_status    @default(posted)
  party_id                String?               @db.Uuid
  product_id              String?               @db.Uuid
  bank_account_id         String?               @db.Uuid
  warehouse_id            String?               @db.Uuid
  quantity                Decimal?              @db.Decimal(18, 3)
  unit_price              Decimal?              @db.Decimal(18, 2)
  total_amount            Decimal               @db.Decimal(18, 2)
  payment_method          payment_method        @default(cash)
  description             String
  reference               String?               @db.VarChar(120)
  transaction_date        DateTime              @db.Date
  reversed_transaction_id String?               @db.Uuid
  version                 Int                   @default(1)
  created_by              String                @db.Uuid
  created_at              DateTime              @default(now()) @db.Timestamptz(6)
  updated_at              DateTime              @default(now()) @db.Timestamptz(6)
  inventory_movements     inventory_movements[]
  bank_accounts           bank_accounts?        @relation(fields: [bank_account_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "transactions_bank_account_id_bank_accounts_id_fk")
  users                   users                 @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "transactions_created_by_users_id_fk")
  parties                 parties?              @relation(fields: [party_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "transactions_party_id_parties_id_fk")
  products                products?             @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "transactions_product_id_products_id_fk")
  warehouses              warehouses?           @relation(fields: [warehouse_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "transactions_warehouse_id_warehouses_id_fk")

  @@index([transaction_date], map: "transactions_date_idx")
  @@index([party_id], map: "transactions_party_idx")
  @@index([product_id], map: "transactions_product_idx")
}

model users {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username             String                @unique(map: "users_username_unique") @db.VarChar(80)
  display_name         String                @db.VarChar(160)
  password_hash        String
  role                 user_role             @default(viewer)
  is_active            Boolean               @default(true)
  must_change_password Boolean               @default(true)
  last_login_at        DateTime?             @db.Timestamptz(6)
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @default(now()) @db.Timestamptz(6)
  app_settings         app_settings[]
  audit_logs           audit_logs[]
  bills                bills[]
  inventory_movements  inventory_movements[]
  journal_entries      journal_entries[]
  notifications        notifications[]
  quality_checks       quality_checks[]
  sessions             sessions[]
  transactions         transactions[]
  work_orders          work_orders[]
  worker_payments      worker_payments[]
}

model warehouses {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String                @unique(map: "warehouses_code_unique") @db.VarChar(40)
  name                String                @db.VarChar(160)
  address             String?
  is_default          Boolean               @default(false)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  inventory_movements inventory_movements[]
  transactions        transactions[]
  work_orders         work_orders[]
}

model work_orders {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number       String             @unique(map: "work_orders_number_unique") @db.VarChar(64)
  bom_id             String             @db.Uuid
  warehouse_id       String             @db.Uuid
  planned_quantity   Decimal            @db.Decimal(18, 3)
  completed_quantity Decimal            @default(0) @db.Decimal(18, 3)
  rejected_quantity  Decimal            @default(0) @db.Decimal(18, 3)
  status             work_order_status  @default(planned)
  planned_start_date DateTime           @db.Date
  completed_at       DateTime?          @db.Timestamptz(6)
  notes              String?
  created_by         String             @db.Uuid
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)
  quality_checks     quality_checks[]
  bills_of_materials bills_of_materials @relation(fields: [bom_id], references: [id], onUpdate: NoAction, map: "work_orders_bom_id_bills_of_materials_id_fk")
  users              users              @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "work_orders_created_by_users_id_fk")
  warehouses         warehouses         @relation(fields: [warehouse_id], references: [id], onUpdate: NoAction, map: "work_orders_warehouse_id_warehouses_id_fk")

  @@index([status])
}

model worker_payments {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worker_id        String                @db.Uuid
  salary_month     DateTime              @db.Date
  gross_amount     Decimal               @db.Decimal(18, 2)
  advance_amount   Decimal               @default(0) @db.Decimal(18, 2)
  deduction_amount Decimal               @default(0) @db.Decimal(18, 2)
  paid_amount      Decimal               @default(0) @db.Decimal(18, 2)
  status           worker_payment_status @default(pending)
  paid_at          DateTime?             @db.Timestamptz(6)
  notes            String?
  created_by       String                @db.Uuid
  created_at       DateTime              @default(now()) @db.Timestamptz(6)
  updated_at       DateTime              @default(now()) @db.Timestamptz(6)
  users            users                 @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "worker_payments_created_by_users_id_fk")
  workers          workers               @relation(fields: [worker_id], references: [id], onUpdate: NoAction, map: "worker_payments_worker_id_workers_id_fk")

  @@unique([worker_id, salary_month], map: "worker_payments_worker_month_unique")
}

model workers {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worker_code     String            @unique(map: "workers_code_unique") @db.VarChar(40)
  name            String            @db.VarChar(160)
  phone           String?           @db.VarChar(40)
  address         String?
  national_id     String?           @db.VarChar(40)
  designation     String?           @db.VarChar(120)
  monthly_salary  Decimal           @default(0) @db.Decimal(18, 2)
  joining_date    DateTime          @db.Date
  status          worker_status     @default(active)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  worker_payments worker_payments[]

  @@index([name])
}

enum account_type {
  asset
  liability
  equity
  revenue
  expense
}

enum audit_action {
  create
  update
  archive
  post
  reverse
  login
  logout
  restore
}

enum bill_status {
  draft
  issued
  partial
  paid
  cancelled
  expired
}

enum bill_type {
  invoice
  quotation
}

enum inventory_movement_type {
  opening
  purchase
  sale
  return_in
  return_out
  adjustment_in
  adjustment_out
  production_issue
  production_output
  transfer_in
  transfer_out
}

enum journal_side {
  debit
  credit
}

enum journal_status {
  posted
  reversed
}

enum payment_method {
  cash
  bank
  cheque
  credit
}

enum transaction_status {
  draft
  posted
  reversed
}

enum transaction_type {
  sale
  purchase
  bank_deposit
  bank_withdrawal
  customer_receipt
  supplier_payment
  adjustment
}

enum user_role {
  admin
  manager
  accounts
  inventory
  production
  viewer
}

enum work_order_status {
  planned
  released
  in_progress
  completed
  cancelled
}

enum worker_payment_status {
  pending
  partial
  paid
}

enum worker_status {
  active
  inactive
}
